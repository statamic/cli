{
    "name": "statamic/cli",
    "description": "Statamic CLI Tool",
    "keywords": ["statamic"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "guzzlehttp/guzzle": "^6.5.5|^7.0.1",
        "illuminate/collections": "^10.0|^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.3.19",
        "symfony/console": "^6.2|^7.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0"
    },
    "bin": [
        "bin/statamic"
    ],
    "autoload": {
        "psr-4": {
            "Statamic\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Statamic\\Cli\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
